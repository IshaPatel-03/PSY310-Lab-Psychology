                <Param name="letterHeight" val="0.05" valType="num" updates="constant" plugin="None"/>
                <Param name="wrapWidth" val="" valType="num" updates="constant" plugin="None"/>
                <Param name="flip" val="None" valType="str" updates="constant" plugin="None"/>
                <Param name="languageStyle" val="LTR" valType="str" updates="None" plugin="None"/>
            </TextComponent>
        </Routine>
    </Routines>
    <Flow>
        <Routine name="Instruction"/>
        <LoopInitiator name="stair" plugin="None" loopType="StairHandler">
            <Param name="name" val="stair" valType="code" updates="None" plugin="None"/>
            <Param name="isTrials" val="True" valType="bool" updates="None" plugin="None"/>
            <Param name="nReps" val="100" valType="code" updates="None" plugin="None"/>
            <Param name="start value" val="10" valType="code" updates="None" plugin="None"/>
            <Param name="max value" val="20" valType="code" updates="None" plugin="None"/>
            <Param name="min value" val="1" valType="code" updates="None" plugin="None"/>
            <Param name="step sizes" val="[2,1,1,0.5]" valType="list" updates="None" plugin="None"/>
            <Param name="step type" val="lin" valType="str" updates="None" plugin="None"/>
            <Param name="N up" val="1" valType="code" updates="None" plugin="None"/>
            <Param name="N down" val="3" valType="code" updates="None" plugin="None"/>
            <Param name="N reversals" val="" valType="code" updates="None" plugin="None"/>
        </LoopInitiator>
        <Routine name="trial"/>
        <LoopTerminator name="stair"/>
        <Routine name="Thanks"/>
    </Flow>
</PsychoPy2experiment>