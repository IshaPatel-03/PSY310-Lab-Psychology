                <Param name="Begin Routine" val="# Randomly choose target side&#10;target_side = random.choice([&quot;left&quot;, &quot;right&quot;])&#10;&#10;if target_side == &quot;left&quot;:&#10;    target_x = -350&#10;    correct_key = &quot;left&quot;&#10;else:&#10;    target_x = 350&#10;    correct_key = &quot;right&quot;&#10;&#10;# Choose arrow direction&#10;if validity == &quot;valid&quot;:&#10;    if target_side == &quot;left&quot;:&#10;        cue = &quot;←&quot;&#10;    else:&#10;        cue = &quot;→&quot;&#10;else:&#10;    if target_side == &quot;left&quot;:&#10;        cue = &quot;→&quot;&#10;    else:&#10;        cue = &quot;←&quot;&#10;&#10;if emotion == &quot;neutral&quot;:&#10;    image_file = random.choice(neutral_images)&#10;else:&#10;    image_file = random.choice(high_images)" valType="extendedCode" updates="constant" plugin="None"/>
